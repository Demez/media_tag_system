@spritesheet theme
{
	src: /assets/invader.tga;

	window-tl: 0px 0px 133px 140px;
	window-t:  134px 0px 1px 140px;
	window-tr: 136px 0px 10px 140px;
	window-l:  0px 139px 10px 1px;
	window-c:  11px 139px 1px 1px;
	window-r:  10px 139px -10px 1px; /* mirrored left */
	window-bl: 0px 140px 11px 11px;
	window-b:  11px 140px 1px 11px;
	window-br: 136px 140px 10px 11px;

}

@keyframes fadeout {
	from {
		opacity: 1;
		visibility: visible;
	}
	to {
		opacity: 0;
		visibility: hidden;
	}
}
@keyframes fadein {
	from {
		opacity: 0;
		visibility: hidden;
	}
	to {
		opacity: 1;
		visibility: visible;
	}
}

@keyframes hover_enter {
	from {
		background-color: green;
	}
	to {
		background-color: blue;
	}
}

.fadeout {
	animation: 1.2s cubic-in fadeout;
	visibility: hidden;
}
.fadein {
	animation: 1.2s cubic-out fadein;
}

body
{
	--font-size: 17px;
	--frame-height: 24px;

	font-family: Default;
	font-weight: normal;
	font-style: normal;
	font-size: 17px;
	font-effect: shadow(2px 2px black);
	color: white;
	margin: 0px;
	background-color: rgba(255, 255, 255, 0);
}

body.window
{
	margin: 0px;
}

sidebar
{
	width: 300px;
	height: 100%;
	overflow: auto;

	margin: 0px;
	background-color: #212121;
}

content
{
	width: 700px;
	height: 600px;
	overflow: auto;

	margin: 0px;
	background-color: #212121;
}

.nav_bar
{
	width: 100%;

	background-color: #212121;

	padding: 8px;
}

header
{
	/*decorator: tiled-box(
		window-tl, window-t, window-tr,
		window-l, window-c, window-r,
		window-bl, window-b, window-br
	);*/

	width: 100%;
	padding: 0px;
}

button
{
	border-radius: 4px;

	width: var(--frame-height);
	height: var(--frame-height);

	margin: 0px;
	margin-right: 8px;

	padding: 2px;
	overflow: auto;

	background-color: #474747ff;
	text-align: center;
}

button:focus, button:hover
{
	background-color: blue;
	animation: 0.1s hover_enter;
}


input
{
	display: inline;
	
	border-radius: 4px;

	height: 24px;

	margin-top: 0px;
	margin-right: 8px;

	padding: 2px;
	padding-left: 4px;
	padding-right: 0px;

	text-align: left;

	background-color: #161616ff;
}

.path_bar
{
	width: 400px;
}

.search_box
{
	width: auto;
}

input:hover
{
	background-color: blue;
}

div
{
	display: block;
}

