bookmarks {
}
thumbnail {
    jxl_distance 4.0
    jxl_effort 6
    jxl_enable #true
    memory_cache_size 20000
    size 600
    threads 8
    threads_save 2
    uploads_per_frame 4
    use_fixed_size #false
}
theme {
    dwm_extend #false
    use_custom_colors #false
    font_size 17
    gallery_header_background_color 0.0 0.0 0.0 0.0
    gallery_content_bg_color 0.0 0.0 0.0 0.0
    gallery_sidebar_bg_color 0.0 0.0 0.0 0.0
    media_background_color 0.0 0.0 0.0 0.0
    gallery_header_padding 6.0 6.0
}
gallery {
    directory_tree_auto_expand #true
    directory_tree_expand_on_click #false
    directory_tree_simple #false
    show_filenames #true
    zoom_default 300
}
general {
    always_draw #false
    dev_mode #false
    high_bpc #false
    no_video #false
    single_instance #false
    job_threads 3
    vsync 0
    media_zoom_scale 0.2
    sleep_time_no_focus 5
    sleep_time_focus 1
    sleep_time_idle 3
}
