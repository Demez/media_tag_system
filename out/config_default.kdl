bookmarks {
}

thumbnail {
	// basic JPEG XL thumbnail quality and speed control
	jxl_distance 1.000000
	jxl_effort 5
	jxl_enable true

	memory_cache_size 20000
	size 600
	threads 8
	threads_save 2
	
	// Max amount of thumbnails you can upload at a time,
	// this blocks the main thread for a second to upload, so don't set this number too high
	uploads_per_frame 4

	use_fixed_size false
}

theme {
	// WINDOWS ONLY _ Allows titlebar color to extend into the window, useful for DWMBlurGlass
	dwm_extend false
	font_size 17

	use_custom_colors false
}

gallery {
	directory_tree_auto_expand true

	// Auto expand the directory tree on clicking on folders in the tree, instead of clicking the arrow
	directory_tree_expand_on_click false

	// Simple Directory Tree list, only shows folders in the current folder you're in
	directory_tree_simple false

	show_filenames true
	zoom_default 300
}

general {
	always_draw false
	dev_mode false
	high_bpc false

	job_threads 3

	// Scale to zoom in/out by with scroll wheel
	media_zoom_scale 0.2

	// Disable video support
	no_video true

	// Only one instance open at a time
	single_instance false

	// Sleep time when the program is running normally, ignoring video playback
	sleep_time_focus 1

	// When the window does not need to be redraw, sleep every frame for this time
	sleep_time_idle 15

	// When the window isn't focused, add a sleep time every frame, 0 to disable
	sleep_time_no_focus 5

	// 0 for immediate updates, 1 for vsync, -1 for adaptive vsync
	vsync 0
}

